# 로컬 개발용 비밀값. `cp .dev.vars.example .dev.vars` 후 사용한다. .dev.vars는 커밋하지 않는다.
# 실서버 값은 `wrangler secret put <이름>`으로 등록하고, 아래 개발용 값을 그대로 쓰지 않는다.
ALF_SECRET=dev-alf-secret
ADMIN_SECRET=dev-admin-secret
CHANNELTALK_WEBHOOK_TOKEN=dev-webhook-token

# DATA_SOURCE=live 일 때만 필요(dropship-engine 읽기 전용 API 토큰)
ENGINE_TOKEN=
