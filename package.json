{
  "name": "ssokgolla-cs-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "쏙골라마켓 위탁판매 CS 자동화 허브 — 채널톡 ALF 태스크용 API",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "cf-typegen": "wrangler types --env-interface GeneratedEnv",
    "db:migrate": "wrangler d1 migrations apply cs-hub --local",
    "seed": "node scripts/seed.ts && wrangler d1 execute cs-hub --local --file .wrangler/seed.sql",
    "report": "node scripts/report.ts",
    "build-knowledge": "node scripts/build-knowledge.ts"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
